  "android_kotlin_example": "\nval module = Module.load(assetFilePath(this, \"resume_model_android.pt\"))\nval inputIds = Tensor.fromBlob(longArrayOf(...), longArrayOf(1, 300))\nval attentionMask = Tensor.fromBlob(longArrayOf(...), longArrayOf(1, 300))\nval outputs = module.forward(IValue.from(inputIds), IValue.from(attentionMask)).toTuple()\nval score = outputs[0].toTensor().dataAsFloatArray[0]\nval probs = outputs[1].toTensor().dataAsFloatArray\n",
  "torch_version": "2.10.0+cpu"
